# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque-esta-senha
DB_NAME=integra_escolar

# Autenticação — troque por uma chave forte e aleatória em produção
# (ex.: gerar com `python3 -c "import secrets; print(secrets.token_hex(32))"`).
# A aplicação recusa iniciar sem essa variável definida.
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-e-forte

# Deploy/produção (opcional — em branco = libera CORS geral, como em
# desenvolvimento local). Em produção, defina a URL real do domínio:
# CORS_ORIGINS=https://integraescolar.com.br
CORS_ORIGINS=

# Deploy/produção (opcional — 0 = modo produção, sem debug; padrão já é 0).
# NUNCA deixe FLASK_DEBUG=1 em produção.
FLASK_DEBUG=0